<style>
    /* 1. Two-Column Blog */
    .blog {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 10px;
    }

    .blog div {
      padding: 20px;
      border: 1px solid black;
    }

    /* 2. Product Grid */
    .products {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    .product {
      padding: 20px;
      border: 1px solid black;
      text-align: center;
    }

    /* 3. Calendar */
    .calendar {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 5px;
    }

    .calendar div {
      padding: 20px;
      border: 1px solid black;
      text-align: center;
    }

    /* 4. Spanning Rows and Columns */
    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .grid div {
      padding: 30px;
      border: 1px solid black;
      text-align: center;
    }

    .item1 {
      grid-column: span 2;
    }

    .item2 {
      grid-row: span 2;
    }

    /* Smaller Screen */
    @media (max-width: 600px) {
      .products {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</head>

